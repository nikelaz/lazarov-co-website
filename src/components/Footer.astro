---
const navLinks = [
  { href: '/', label: 'Company' },
  { href: '/products', label: 'Products' },
  { href: '/contact', label: 'Contact' },
];

const footerLinks = [
  { href: '/privacy-policy', label: 'Privacy Policy' },
  { href: '/cookie-policy', label: 'Cookie Policy' },
  { href: '/legal-notice', label: 'Legal Notice' },
  { href: '/terms', label: 'Terms' },
];
---

<footer class="border-t border-line bg-panel">
  <div class="container grid gap-12 py-14 lg:grid-cols-3">
    <div>
      <p class="font-serif text-2xl text-ink">Lazarov &amp; Co Ltd.</p>
      <p class="mt-4 max-w-md text-sm leading-7 text-muted">
        Native software products built with care
      </p>
    </div>
    <nav aria-label="Footer navigation" class="flex flex-col gap-3 text-sm text-muted">
      {navLinks.map((item) => <a class="hover:text-ink" href={item.href}>{item.label}</a>)}
    </nav>
    <nav aria-label="Legal navigation" class="flex flex-col gap-3 text-sm text-muted">
      {footerLinks.map((item) => <a class="hover:text-ink" href={item.href}>{item.label}</a>)}
    </nav>
  </div>
  <div class="border-t border-line px-5 py-6 text-center text-xs text-muted sm:px-8">
    © {new Date().getFullYear()} Lazarov & Co Ltd.
  </div>
</footer>
