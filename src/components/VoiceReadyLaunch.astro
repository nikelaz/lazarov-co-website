---
const storeUrl = 'https://apps.microsoft.com/detail/9P1LF881W64N?hl=en-us&gl=US&ocid=pdpshare';
const confetti = [
  ['3%', '-.3s', '9px', '#1769aa'], ['7%', '-2.1s', '7px', '#e39b18'],
  ['12%', '-1.2s', '10px', '#d54336'], ['17%', '-3.4s', '8px', '#398c50'],
  ['22%', '-.8s', '7px', '#8056b3'], ['27%', '-2.7s', '10px', '#e39b18'],
  ['32%', '-1.7s', '8px', '#1769aa'], ['37%', '-3.8s', '7px', '#d54336'],
  ['42%', '-.5s', '10px', '#398c50'], ['47%', '-2.4s', '8px', '#8056b3'],
  ['52%', '-1.4s', '7px', '#e39b18'], ['57%', '-3.1s', '10px', '#1769aa'],
  ['62%', '-1s', '8px', '#d54336'], ['67%', '-2.9s', '7px', '#398c50'],
  ['72%', '-1.9s', '9px', '#8056b3'], ['77%', '-3.6s', '8px', '#e39b18'],
  ['82%', '-.7s', '10px', '#1769aa'], ['87%', '-2.5s', '7px', '#d54336'],
  ['92%', '-1.5s', '9px', '#398c50'], ['97%', '-3.2s', '8px', '#8056b3'],
];
---

<section class="launch-announcement relative isolate overflow-hidden border-y border-line bg-white" aria-labelledby="voice-ready-launch-title">
  <div class="launch-confetti pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    {confetti.map(([left, delay, size, color], index) => (
      <i style={`--confetti-left:${left};--confetti-delay:${delay};--confetti-size:${size};--confetti-color:${color};--confetti-drift:${index % 2 ? '32px' : '-28px'};--confetti-turn:${index % 3 ? '540deg' : '-480deg'}`}></i>
    ))}
  </div>

  <div class="container relative z-10 grid gap-8 py-12 sm:py-14 lg:grid-cols-[1fr_auto] lg:items-center">
    <div class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent">Just released</p>
      <h2 id="voice-ready-launch-title" class="mt-3 font-serif text-3xl leading-tight text-ink sm:text-4xl">Voice Ready is now available for Windows.</h2>
      <p class="mt-4 text-lg leading-8 text-muted">Clean, balance, and prepare spoken audio in one focused desktop app. macOS and Linux are coming soon.</p>
    </div>
    <a href={storeUrl} target="_blank" rel="noopener noreferrer" class="inline-flex w-fit items-center gap-3 bg-ink px-6 py-3.5 text-sm font-medium text-paper transition hover:bg-button-hover">
      Download from Microsoft Store
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .launch-announcement {
    background-image: radial-gradient(circle at 86% 50%, rgba(31, 78, 121, 0.09), transparent 30%);
  }

  .launch-confetti i {
    position: absolute;
    top: -1rem;
    left: var(--confetti-left);
    width: var(--confetti-size);
    height: calc(var(--confetti-size) * 1.8);
    border-radius: 1px;
    background: var(--confetti-color);
    z-index: 0;
    opacity: 0;
    box-shadow: 0 0 0 0.5px rgb(25 24 23 / 12%);
    animation: launch-confetti-fall 3.6s var(--confetti-delay) linear infinite;
  }

  @keyframes launch-confetti-fall {
    0% { opacity: 0; transform: translate3d(0, -1rem, 0) rotate(0); }
    5% { opacity: 1; }
    92% { opacity: 0.95; }
    100% { opacity: 0; transform: translate3d(var(--confetti-drift), 22rem, 0) rotate(var(--confetti-turn)); }
  }
</style>
