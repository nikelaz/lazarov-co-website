---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<div class="max-w-3xl">
  {eyebrow && <p class="mb-5 text-xs font-semibold uppercase tracking-[0.22em] text-accent">{eyebrow}</p>}
  <h2 class="font-serif text-4xl leading-tight text-ink sm:text-5xl">{title}</h2>
  {intro && <p class="mt-6 text-lg leading-8 text-muted">{intro}</p>}
</div>
