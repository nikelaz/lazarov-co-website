---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/voice-ready';
const canonicalUrl = new URL(Astro.url.pathname, 'https://lazarovco.com');
const socialImageUrl = new URL('/images/social/voice-ready.png', 'https://lazarovco.com');
const storeUrl = 'https://apps.microsoft.com/detail/9P1LF881W64N?hl=en-us&gl=US&ocid=pdpshare';
const links = [
  { href: '/voice-ready', label: 'Overview' },
  { href: '/voice-ready/download', label: 'Download' },
  { href: '/voice-ready/support', label: 'Support' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lazarov & Co" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Voice Ready product overview" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>
    <script data-goatcounter="https://lazarovco.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body class="voice-site min-h-screen bg-paper font-sans text-ink antialiased">
    <Header compact />
    <header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur-xl">
      <div class="container flex flex-wrap items-center justify-between gap-5 py-4">
        <a href="/voice-ready" class="flex items-center gap-3" aria-label="Voice Ready home">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-[#171719] text-white">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6 fill-none stroke-current"><path d="M4 12h2m2-4v8m3-11v14m3-11v8m3-6v4m3-3v2" stroke-width="1.6" stroke-linecap="round" /></svg>
          </span>
          <span class="text-lg font-semibold">Voice Ready</span>
        </a>
        <nav class="order-3 flex w-full items-center gap-5 overflow-x-auto text-sm text-muted md:order-2 md:w-auto md:gap-7" aria-label="Voice Ready navigation">
          {links.map((link) => <a class:list={['whitespace-nowrap transition hover:text-accent', path === link.href && 'text-ink']} href={link.href}>{link.label}</a>)}
        </nav>
        <a href={storeUrl} target="_blank" rel="noopener noreferrer" class="order-2 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-paper transition hover:bg-button-hover md:order-3">Get for Windows</a>
      </div>
    </header>
    <main><slot /></main>
    <Footer />
  </body>
</html>
