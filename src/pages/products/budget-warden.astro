---
import BudgetWardenLayout from '../../layouts/BudgetWardenLayout.astro';
---
<BudgetWardenLayout title="Budget Warden | Your budget, clearly" description="Budget Warden is a straightforward personal finance app for iPhone, iPad, Mac, and Android, with Windows coming soon.">
  <section class="overflow-hidden">
    <div class="container grid items-center gap-14 py-20 lg:grid-cols-[0.9fr_1.1fr] lg:py-28">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#355F8E]">Available now</p>
        <h1 class="mt-6 max-w-xl font-serif text-5xl leading-[1.02] text-ink sm:text-7xl">Know where your money is going.</h1>
        <p class="mt-7 max-w-xl text-xl leading-9 text-[#52627A]">Budget Warden gives you a calm, structured place to plan spending, track transactions, and stay in control without turning personal finance into a second job.</p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="https://www.budgetwarden.com/download/" target="_blank" rel="noreferrer" class="rounded-full bg-ink px-7 py-3.5 text-sm font-semibold text-paper transition hover:bg-button-hover">Download</a>
        </div>
        <p class="mt-6 text-sm text-[#66758B]">For iPhone, iPad, Mac, and Android. Windows coming soon.</p>
      </div>
      <div class="relative mx-auto w-full max-w-2xl rounded-[2rem] bg-[#E4EEFF] p-5 shadow-[0_35px_80px_rgba(23,60,53,.18)] sm:p-9">
        <div class="rounded-2xl border border-[#03318B]/10 bg-[#FFFFFF] p-6 sm:p-8">
          <div class="flex items-start justify-between border-b border-[#03318B]/10 pb-6">
            <div><p class="text-sm text-[#66758B]">This month</p><p class="mt-2 text-3xl font-semibold">£2,840.00</p></div>
            <span class="rounded-full bg-[#E4EEFF] px-3 py-1 text-xs font-semibold">On track</span>
          </div>
          <div class="mt-7 grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl bg-[#EEF3FC] p-5"><p class="text-sm text-[#66758B]">Available to spend</p><p class="mt-2 text-2xl font-semibold">£1,126</p></div>
            <div class="rounded-xl bg-[#EEF3FC] p-5"><p class="text-sm text-[#66758B]">Saved this month</p><p class="mt-2 text-2xl font-semibold">£460</p></div>
          </div>
          <div class="mt-7 space-y-4">
            <div class="flex items-center gap-4"><span class="h-3 w-[72%] rounded-full bg-[#1677FF]"></span><span class="text-sm">Home</span></div>
            <div class="flex items-center gap-4"><span class="h-3 w-[46%] rounded-full bg-[#8CB8F5]"></span><span class="text-sm">Food</span></div>
            <div class="flex items-center gap-4"><span class="h-3 w-[30%] rounded-full bg-[#E8B084]"></span><span class="text-sm">Travel</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-[#03318B]/15 bg-[#03318B] text-white">
    <div class="container grid gap-px py-16 md:grid-cols-3">
      <div class="py-6 md:pr-6"><h2 class="text-xl font-semibold text-white">Plan with purpose</h2><p class="mt-3 text-lg leading-8 text-white/80">Give your income a job and see what is safe to spend before the month gets away from you.</p></div>
      <div class="border-[#ffffff]/15 py-6 md:border-x md:px-6"><h2 class="text-xl font-semibold text-white">See the whole picture</h2><p class="mt-3 text-lg leading-8 text-white/80">Organize transactions and categories in one clear view built for everyday decisions.</p></div>
      <div class="py-6 md:pl-6"><h2 class="text-xl font-semibold text-white">Use it everywhere</h2><p class="mt-3 text-lg leading-8 text-white/80">Keep your budget close on phone, tablet, and desktop with native apps for your devices.</p></div>
    </div>
  </section>

  <section class="container py-24 text-center">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#355F8E]">A calmer money habit</p>
    <h2 class="mx-auto mt-5 max-w-3xl font-serif text-4xl leading-tight sm:text-6xl">A budget you will actually want to keep.</h2>
    <p class="mx-auto mt-7 max-w-2xl text-lg leading-8 text-[#52627A]">Start with a clear plan, check in as life happens, and make your next decision with confidence.</p>
    <a href="https://www.budgetwarden.com/download/" target="_blank" rel="noreferrer" class="mt-10 inline-block rounded-full bg-ink px-8 py-4 text-sm font-semibold text-paper transition hover:bg-button-hover">Download</a>
  </section>
</BudgetWardenLayout>
