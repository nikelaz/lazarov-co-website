---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Products | Lazarov & Co Ltd." description="Explore Budget Warden and Voice Ready, focused software products built by Lazarov & Co Ltd.">
  <section class="container py-20">
    <p class="mb-6 text-xs font-semibold uppercase tracking-[0.24em] text-accent">Products</p>
    <h1 class="font-serif text-4xl leading-tight text-ink sm:text-6xl">Small Focused Tools</h1>
    <p class="mt-8 max-w-none text-xl leading-9 text-muted">Focused applications designed to do a useful job well, with native performance and direct support.</p>
  </section>

  <section class="container grid gap-6 pb-24 lg:grid-cols-2">
      <article class="border border-line bg-white p-8 sm:p-12">
        <div class="flex items-center gap-4">
          <img src="/images/budget-warden-icon.svg" alt="" class="h-14 w-14 rounded-2xl" width="56" height="56" />
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#355F8E]">Available now</p>
            <h2 class="mt-1 font-serif text-4xl text-ink">Budget Warden</h2>
          </div>
        </div>
        <p class="mt-8 text-xl leading-8 text-ink">A clear, private way to plan a budget and understand where your money goes.</p>
        <p class="mt-5 leading-8 text-muted">Budget Warden is available for iPhone, iPad, Mac, Android, and Windows. Your financial data stays close at hand in an app built for clarity rather than complexity.</p>
        <div class="mt-8 flex flex-wrap gap-2 text-xs font-medium uppercase tracking-wider text-muted">
          <span class="border border-line px-3 py-2">iPhone</span><span class="border border-line px-3 py-2">iPad</span><span class="border border-line px-3 py-2">macOS</span><span class="border border-line px-3 py-2">Android</span><span class="border border-line px-3 py-2">Windows</span>
        </div>
        <a href="/products/budget-warden" class="mt-10 inline-flex items-center gap-3 bg-ink px-6 py-3 text-sm font-medium text-paper transition hover:bg-button-hover">Explore Budget Warden <span aria-hidden="true">→</span></a>
      </article>

      <article class="border border-line bg-white p-8 sm:p-12">
        <div class="flex items-center gap-4">
          <span class="grid h-14 w-14 place-items-center rounded-2xl bg-[#171719] text-white">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-8 w-8 fill-none stroke-current"><path d="M4 12h2m2-4v8m3-11v14m3-11v8m3-6v4m3-3v2" stroke-width="1.6" stroke-linecap="round" /></svg>
          </span>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#355F8E]">Free demo available on Windows</p>
            <h2 class="mt-1 font-serif text-4xl text-ink">Voice Ready</h2>
          </div>
        </div>
        <p class="mt-8 text-xl leading-8 text-ink">Turn spoken audio into clean, balanced, publication-ready sound.</p>
        <p class="mt-5 leading-8 text-muted">Voice Ready reduces background noise, balances speech, shapes tone, and targets the right final volume without making audio engineering your job. Try every feature free with demo exports limited to 3 minutes per file.</p>
        <div class="mt-8 flex flex-wrap gap-2 text-xs font-medium uppercase tracking-wider text-muted">
          <span class="border border-dashed border-line px-3 py-2">macOS soon</span><span class="border border-line px-3 py-2">Windows</span><span class="border border-dashed border-line px-3 py-2">Linux soon</span>
        </div>
        <a href="/voice-ready" class="mt-10 inline-flex items-center gap-3 border border-ink px-6 py-3 text-sm font-medium text-ink transition hover:bg-ink hover:text-paper">Discover Voice Ready <span aria-hidden="true">→</span></a>
      </article>
  </section>
</BaseLayout>
