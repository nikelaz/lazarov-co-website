---
import VoiceReadyLayout from '../../layouts/VoiceReadyLayout.astro';
---
<VoiceReadyLayout title="Download | Voice Ready" description="Voice Ready is coming soon to macOS, Windows, and Linux.">
  <section class="container py-20 text-center sm:py-28">
    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent">Coming soon</p>
    <h1 class="mx-auto mt-5 max-w-4xl text-5xl font-semibold tracking-[-0.045em] sm:text-7xl">Your voice, ready on your desktop.</h1>
    <p class="mx-auto mt-7 max-w-2xl text-xl leading-9 text-muted">Voice Ready will launch for macOS, Windows, and Linux. Store and direct downloads are not open yet.</p>

    <div class="mx-auto mt-14 grid max-w-5xl gap-10 text-left md:grid-cols-2">
      <div>
        <article class="rounded-2xl border border-line bg-white p-8">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-12 w-12 fill-current text-ink">
            <path d="M3 5.6 10.4 4.6v7H3V5.6Zm8.5-1.2L21 3v8.6h-9.5V4.4ZM3 12.7h7.4v7L3 18.7v-6Zm8.5 0H21V21l-9.5-1.3v-7Z" />
          </svg>
          <h2 class="mt-6 text-3xl font-semibold">Windows</h2>
          <p class="mt-2 text-muted">Will be available from the Microsoft Store.</p>
          <button type="button" disabled class="mt-8 w-full cursor-not-allowed rounded-full bg-panel px-6 py-3 text-sm font-semibold text-muted">Coming soon</button>
        </article>
        <section class="mt-5 border-t border-line pt-6" aria-labelledby="windows-requirements">
          <h3 id="windows-requirements" class="text-lg font-semibold">System requirements</h3>
          <ul class="mt-4 grid gap-2 text-sm leading-6 text-muted">
            <li>Windows 10 version 1809 or Windows 11</li>
            <li>x64 dual-core processor; four cores recommended</li>
            <li>4 GB memory; 8 GB recommended</li>
            <li>OpenGL 3.3-capable graphics</li>
            <li>250 MB app space, plus room for working media</li>
          </ul>
        </section>
      </div>

      <div>
        <article class="rounded-2xl border border-line bg-white p-8">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-12 w-12 fill-current text-ink">
            <path d="M17.1 12.5c0-2.8 2.3-4.2 2.4-4.3a5.2 5.2 0 0 0-4.1-2.2c-1.7-.2-3.4 1-4.3 1-.9 0-2.3-1-3.8-1-2 0-3.8 1.2-4.8 3-2.1 3.6-.5 8.9 1.5 11.8 1 1.4 2.1 3 3.7 2.9 1.5-.1 2.1-1 3.9-1s2.3 1 3.9 1c1.6 0 2.7-1.4 3.6-2.9 1.1-1.7 1.6-3.3 1.6-3.4-.1 0-3.6-1.4-3.6-4.9ZM14.3 4.2A5 5 0 0 0 15.5.6a5.1 5.1 0 0 0-3.4 1.7A4.8 4.8 0 0 0 10.9 6a4.2 4.2 0 0 0 3.4-1.8Z" />
          </svg>
          <h2 class="mt-6 text-3xl font-semibold">macOS</h2>
          <p class="mt-2 text-muted">Will be available from the Mac App Store.</p>
          <button type="button" disabled class="mt-8 w-full cursor-not-allowed rounded-full bg-panel px-6 py-3 text-sm font-semibold text-muted">Coming soon</button>
        </article>
        <section class="mt-5 border-t border-line pt-6" aria-labelledby="mac-requirements">
          <h3 id="mac-requirements" class="text-lg font-semibold">System requirements</h3>
          <ul class="mt-4 grid gap-2 text-sm leading-6 text-muted">
            <li>macOS 13 Ventura or newer</li>
            <li>Apple silicon or 64-bit Intel processor</li>
            <li>4 GB memory; 8 GB recommended</li>
            <li>250 MB app space, plus room for working media</li>
          </ul>
        </section>
      </div>
    </div>
  </section>

</VoiceReadyLayout>
