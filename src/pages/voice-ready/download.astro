---
import VoiceReadyLayout from '../../layouts/VoiceReadyLayout.astro';
import { voiceReadyDemoStoreUrl, voiceReadyMacDemoUrl, voiceReadyStoreUrl } from '../../voice-ready';
---
<VoiceReadyLayout title="Download Voice Ready for Windows & macOS | Free Demo" description="Try every Voice Ready feature free on Windows or macOS with exports limited to 3 minutes. The full app is available on Windows and coming soon to Mac.">
  <section class="container py-20 text-center sm:py-28">
    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent">Free demo for Windows and macOS</p>
    <h1 class="mx-auto mt-5 max-w-4xl text-4xl font-semibold tracking-[-0.045em] sm:text-7xl">Try Voice Ready free, or get the full app.</h1>
    <p class="mx-auto mt-7 max-w-2xl text-xl leading-9 text-muted">Start with every feature and export up to 3 minutes per file. The full app is available on Windows and coming soon to Mac.</p>

    <div class="mx-auto mt-14 max-w-5xl text-left">
      <section aria-labelledby="windows-downloads">
        <div class="flex items-center gap-4">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-12 w-12 fill-current text-ink">
            <path d="M3 5.6 10.4 4.6v7H3V5.6Zm8.5-1.2L21 3v8.6h-9.5V4.4ZM3 12.7h7.4v7L3 18.7v-6Zm8.5 0H21V21l-9.5-1.3v-7Z" />
          </svg>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Microsoft Store</p>
            <h2 id="windows-downloads" class="mt-1 text-3xl font-semibold">Voice Ready for Windows</h2>
          </div>
        </div>

        <div class="mt-8 grid gap-5 md:grid-cols-2">
          <article class="flex flex-col rounded-2xl border border-accent bg-white p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Free demo</p>
            <h3 class="mt-3 text-3xl font-semibold">Try every feature</h3>
            <p class="mt-4 leading-7 text-muted">See how Voice Ready works with your own audio and video before buying.</p>
            <ul class="mt-6 grid gap-3 text-sm leading-6 text-muted">
              <li>All editing and preview features</li>
              <li>Audio and video files</li>
              <li>Exports limited to 3 minutes per file</li>
            </ul>
            <div class="mt-10 md:mt-auto md:pt-10">
              <a href={voiceReadyDemoStoreUrl} target="_blank" rel="noopener noreferrer" data-goatcounter-click="voice-ready-demo-download" class="block w-full rounded-full bg-ink px-6 py-3 text-center text-sm font-semibold text-paper transition hover:bg-button-hover">Get the Free Demo <span aria-hidden="true">↗</span></a>
            </div>
          </article>

          <article class="flex flex-col rounded-2xl border border-line bg-white p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">Paid app</p>
            <h3 class="mt-3 text-3xl font-semibold">Export complete recordings</h3>
            <p class="mt-4 leading-7 text-muted">Get the full app when you are ready to process recordings without the demo's time limit.</p>
            <ul class="mt-6 grid gap-3 text-sm leading-6 text-muted">
              <li>All editing and preview features</li>
              <li>Audio and video files</li>
              <li>No export-length limit</li>
            </ul>
            <p class="mt-6 text-sm text-muted">Your local price is shown in the Microsoft Store.</p>
            <div class="mt-10 md:mt-auto md:pt-10">
              <a href={voiceReadyStoreUrl} target="_blank" rel="noopener noreferrer" data-goatcounter-click="voice-ready-full-download" class="block w-full rounded-full border border-ink px-6 py-3 text-center text-sm font-semibold text-ink transition hover:bg-ink hover:text-paper">Buy the Full App <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        </div>

        <section class="mt-12 border-t border-line pt-6" aria-labelledby="windows-requirements">
          <h3 id="windows-requirements" class="text-lg font-semibold">Windows system requirements</h3>
          <ul class="mt-4 grid gap-2 text-sm leading-6 text-muted sm:grid-cols-2">
            <li>Windows 10 version 1809 or Windows 11</li>
            <li>x64 dual-core processor; four cores recommended</li>
            <li>4 GB memory; 8 GB recommended</li>
            <li>OpenGL 3.3-capable graphics</li>
            <li>250 MB app space, plus room for working media</li>
          </ul>
        </section>
      </section>

      <section class="mt-16 border-t border-line pt-10" aria-labelledby="mac-downloads">
        <div class="flex items-center gap-4">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-12 w-12 fill-current text-ink">
            <path d="M17.1 12.5c0-2.8 2.3-4.2 2.4-4.3a5.2 5.2 0 0 0-4.1-2.2c-1.7-.2-3.4 1-4.3 1-.9 0-2.3-1-3.8-1-2 0-3.8 1.2-4.8 3-2.1 3.6-.5 8.9 1.5 11.8 1 1.4 2.1 3 3.7 2.9 1.5-.1 2.1-1 3.9-1s2.3 1 3.9 1c1.6 0 2.7-1.4 3.6-2.9 1.1-1.7 1.6-3.3 1.6-3.4-.1 0-3.6-1.4-3.6-4.9ZM14.3 4.2A5 5 0 0 0 15.5.6a5.1 5.1 0 0 0-3.4 1.7A4.8 4.8 0 0 0 10.9 6a4.2 4.2 0 0 0 3.4-1.8Z" />
          </svg>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Direct download</p>
            <h2 id="mac-downloads" class="mt-1 text-3xl font-semibold">Voice Ready for macOS</h2>
          </div>
        </div>

        <div class="mt-8 grid gap-5 md:grid-cols-2">
          <article class="flex flex-col rounded-2xl border border-accent bg-white p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Free demo</p>
            <h3 class="mt-3 text-3xl font-semibold">Try every feature</h3>
            <p class="mt-4 leading-7 text-muted">Download the Mac installer and try Voice Ready with your own audio and video.</p>
            <ul class="mt-6 grid gap-3 text-sm leading-6 text-muted">
              <li>All editing and preview features</li>
              <li>Audio and video files</li>
              <li>Exports limited to 3 minutes per file</li>
            </ul>
            <div class="mt-10 md:mt-auto md:pt-10">
              <a href={voiceReadyMacDemoUrl} download="VoiceReadyDemo-v1.0.2.pkg" data-goatcounter-click="voice-ready-mac-demo-download" class="block w-full rounded-full bg-ink px-6 py-3 text-center text-sm font-semibold text-paper transition hover:bg-button-hover">Download the Free Demo</a>
            </div>
          </article>

          <article class="flex flex-col rounded-2xl border border-line bg-white p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">Full Mac app</p>
            <h3 class="mt-3 text-3xl font-semibold">Export complete recordings</h3>
            <p class="mt-4 leading-7 text-muted">The full Mac app will remove the demo's 3-minute export limit.</p>
            <ul class="mt-6 grid gap-3 text-sm leading-6 text-muted">
              <li>All editing and preview features</li>
              <li>Audio and video files</li>
              <li>No export-length limit</li>
            </ul>
            <div class="mt-10 md:mt-auto md:pt-10">
              <button type="button" disabled class="w-full cursor-not-allowed rounded-full bg-panel px-6 py-3 text-sm font-semibold text-muted">Coming soon</button>
            </div>
          </article>
        </div>

        <section class="mt-12 border-t border-line pt-6" aria-labelledby="mac-requirements">
          <h3 id="mac-requirements" class="text-lg font-semibold">System requirements</h3>
          <ul class="mt-4 grid gap-2 text-sm leading-6 text-muted sm:grid-cols-2">
            <li>macOS 13 Ventura or newer</li>
            <li>Apple silicon processor (M1 or newer)</li>
            <li>4 GB memory; 8 GB recommended</li>
            <li>250 MB app space, plus room for working media</li>
          </ul>
        </section>
      </section>
    </div>
  </section>

</VoiceReadyLayout>
