---
import VoiceReadyLayout from '../../layouts/VoiceReadyLayout.astro';
const storeUrl = 'https://apps.microsoft.com/detail/9P1LF881W64N?hl=en-us&gl=US&ocid=pdpshare';
---
<VoiceReadyLayout title="Voice Ready | Clear voice. Less work." description="Voice Ready cleans, balances, and prepares spoken audio for publishing on macOS, Windows, and Linux.">
  <section class="relative overflow-hidden border-b border-line">
    <div class="pointer-events-none absolute inset-x-0 top-0 mx-auto h-[40rem] max-w-5xl bg-[radial-gradient(circle,rgba(31,78,121,.10),transparent_60%)]"></div>
    <div class="container relative pt-20 text-center sm:pt-28">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent">Voice finishing, simplified</p>
      <h1 class="mx-auto mt-6 max-w-5xl text-5xl font-semibold leading-[.98] tracking-[-0.05em] sm:text-7xl lg:text-8xl">Clear voice.<br />Less work.</h1>
      <p class="mx-auto mt-8 max-w-2xl text-xl leading-9 text-muted">Drop in audio or video. Reduce background noise, even out speech, shape the tone, and deliver the right loudness, all in one focused app.</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={storeUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-ink px-7 py-3.5 text-sm font-semibold text-paper transition hover:bg-button-hover">Download for Windows <span aria-hidden="true">↗</span></a>
      </div>
      <p class="mt-5 text-sm text-muted">Available now for Windows. macOS and Linux are coming soon.</p>
      <div class="mt-16 overflow-hidden rounded-t-2xl border border-b-0 border-line bg-white p-2 shadow-[0_-10px_80px_rgba(31,78,121,.08)] sm:p-3">
        <img src="/images/voice-ready-ui.webp" alt="Voice Ready interface showing noise reduction, voice balance, tone, volume, and audio preview controls" class="w-full rounded-xl" width="1372" height="1062" />
      </div>
    </div>
  </section>

  <section class="container py-24 sm:py-32">
    <div class="grid gap-16 lg:grid-cols-[0.75fr_1.25fr]">
      <div><p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent">A complete voice chain</p><h2 class="mt-5 text-4xl font-semibold tracking-[-0.035em] sm:text-5xl">From raw recording to ready.</h2></div>
      <div class="grid gap-px overflow-hidden rounded-2xl border border-line bg-white sm:grid-cols-2">
        <article class="bg-paper p-7"><p class="text-2xl">01</p><h3 class="mt-8 text-lg font-semibold">Noise Reduction with Deep Learning</h3><p class="mt-3 leading-7 text-muted">Reduce background noise with a model that runs locally on your device. It may not match frontier cloud processing, but you can use it without limits, uploads, or subscriptions.</p></article>
        <article class="bg-paper p-7"><p class="text-2xl">02</p><h3 class="mt-8 text-lg font-semibold">Simple Voice Balance</h3><p class="mt-3 leading-7 text-muted">Make loud and quiet parts of your voice feel more even with a few straightforward strength presets. No audio-editing experience required.</p></article>
        <article class="bg-paper p-7"><p class="text-2xl">03</p><h3 class="mt-8 text-lg font-semibold">Easy Voice Tone</h3><p class="mt-3 leading-7 text-muted">Choose from three useful tone presets to shape how your voice sounds without dealing with a full equalizer or technical controls.</p></article>
        <article class="bg-paper p-7"><p class="text-2xl">04</p><h3 class="mt-8 text-lg font-semibold">Target Loudness for Your Platform</h3><p class="mt-3 leading-7 text-muted">Set the right final volume for broadcast, podcasts, or YouTube with a simple preset made for each destination.</p></article>
      </div>
    </div>
  </section>

  {/* Audio demo temporarily hidden. */}
  {false && (
  <section class="border-y border-line bg-panel">
    <div class="container grid gap-12 py-24 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
      <div class="max-w-xl">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent">Audio demo</p>
        <h2 class="mt-5 text-4xl font-semibold tracking-[-0.035em] sm:text-5xl">Hear the Difference</h2>
        <p class="mt-6 text-lg leading-8 text-muted">Choose a sample, then switch between the original recording and the Voice Ready result. Hear what local processing can do before you export a file of your own.</p>
      </div>

      <div class="voice-demo rounded-2xl border border-line bg-white p-5 sm:p-7">
        <div class="flex flex-wrap gap-2 border-b border-line pb-5" role="tablist" aria-label="Audio samples">
          <button class="voice-demo-tab rounded-full border border-line px-4 py-2 text-sm font-medium text-muted" type="button" role="tab" aria-selected="true" data-sample="noise" data-original="/audio/voice-ready/voice-sample-original.wav" data-enhanced="/audio/voice-ready/voice-sample-enhanced.wav">Background noise</button>
          <button class="voice-demo-tab rounded-full border border-line px-4 py-2 text-sm font-medium text-muted" type="button" role="tab" aria-selected="false" data-sample="balance" data-original="/audio/voice-ready/voice-sample-original.wav" data-enhanced="/audio/voice-ready/voice-sample-balanced.wav">Voice balance</button>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
          <div><p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted">Now playing</p><p id="demo-status" class="mt-1 font-semibold text-ink" aria-live="polite">Background noise, Original</p></div>
          <div class="flex rounded-full border border-line bg-panel p-1" aria-label="Audio version">
            <button class="voice-demo-mode rounded-full px-4 py-2 text-sm font-semibold" type="button" aria-pressed="true" data-mode="original">Original</button>
            <button class="voice-demo-mode rounded-full px-4 py-2 text-sm font-semibold" type="button" aria-pressed="false" data-mode="enhanced">Enhanced</button>
          </div>
        </div>

        <audio id="voice-demo-player" class="mt-7 w-full" controls preload="metadata" src="/audio/voice-ready/voice-sample-original.wav">Your browser does not support audio playback.</audio>
      </div>
    </div>
  </section>
  )}

  <section class="border-y border-line bg-white"><div class="container py-24 text-center sm:py-32"><h2 class="mx-auto max-w-3xl text-4xl font-semibold tracking-[-0.04em] sm:text-6xl">Spend less time fixing audio.</h2><p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-muted">Available now for Windows. macOS and Linux are coming soon.</p><a href={storeUrl} target="_blank" rel="noopener noreferrer" class="mt-9 inline-block rounded-full bg-ink px-8 py-4 text-sm font-semibold text-paper transition hover:bg-button-hover">Download for Windows <span aria-hidden="true">↗</span></a></div></section>
  <script>
    const player = document.querySelector<HTMLAudioElement>('#voice-demo-player');
    const status = document.querySelector<HTMLElement>('#demo-status');
    const sampleTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.voice-demo-tab'));
    const modeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.voice-demo-mode'));
    let currentSample = sampleTabs[0];
    let currentMode = 'original';

    function updateDemo() {
      if (!player || !currentSample) return;
      const wasPlaying = !player.paused;
      const source = currentMode === 'enhanced' ? currentSample.dataset.enhanced : currentSample.dataset.original;
      if (!source) return;
      player.src = source;
      player.load();
      if (status) status.textContent = `${currentSample.textContent?.trim()}, ${currentMode === 'enhanced' ? 'Enhanced' : 'Original'}`;
      if (wasPlaying) player.play().catch(() => {});
    }

    sampleTabs.forEach((tab) => tab.addEventListener('click', () => {
      sampleTabs.forEach((item) => item.setAttribute('aria-selected', String(item === tab)));
      currentSample = tab;
      updateDemo();
    }));

    modeButtons.forEach((button) => button.addEventListener('click', () => {
      modeButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      currentMode = button.dataset.mode || 'original';
      updateDemo();
    }));
  </script>
</VoiceReadyLayout>
